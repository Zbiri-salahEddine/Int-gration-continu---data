# Modèle du fichier .env de production (la CD le génère depuis les secrets GitHub).
# Le mot de passe PostgreSQL entre dans une URL : n'utiliser que lettres et chiffres.
IMAGE=ghcr.io/proprietaire/depot/processeur:sha
POSTGRES_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
GRAFANA_PASSWORD=
INTERVALLE_SECONDES=30
